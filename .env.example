# ------------------------------------------------------------------
# El Observador Cubano — variables de entorno
# Copia este archivo a `.env` (lo leen Next.js y la CLI de Prisma).
# Nunca commitees secretos.
# ------------------------------------------------------------------

# URL pública del sitio (sin barra final)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# PostgreSQL (Neon, Prisma Postgres o instancia local)
DATABASE_URL="postgresql://usuario:contrasena@localhost:5432/observador?schema=public"

# Better Auth — genera un secreto con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Almacenamiento S3-compatible (Cloudflare R2) — Fase 3
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Correo transaccional (Resend) — Fase 4
RESEND_API_KEY=""
EMAIL_FROM=""

# Analítica agregada sin cookies — Fase 6 (opcional)
ANALYTICS_SALT=""
